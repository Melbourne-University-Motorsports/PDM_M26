{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/PDM_M26.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "showDevDebugOutput": "raw",
      "device": "STM32G431KB",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32g4x.cfg"
      ],
      "runToEntryPoint": "main",
      "swoConfig": {
        "enabled": true,
        "cpuFrequency": 16000000,
        "swoFrequency": 2000000,
        "source": "probe",
        "decoders": [
          { "type": "console", "label": "ITM", "port": 0 }
        ]
        
      }
    }
  ]
}